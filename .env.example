# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Telos is Postgres-only and refuses to boot
# without this. `npm run db:up` starts a local one matching this default.
DATABASE_URL=postgres://telos:telos@127.0.0.1:5435/telos

# Secret sessions are signed with. The server refuses to start in production
# while this is unset, shorter than 32 characters, or still the default.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# ── Signing in: at least one of these ─────────────────────────────────────────

# Email sign-in links through this SMTP server (a nodemailer connection URL).
# Unset, no links are sent at all.
# SMTP_URL=smtp://user:pass@mail.example.com:587
# The address sign-in email comes from. Default: telos@<APP_URL's host>
# SMTP_FROM=telos@example.com

# SECURE_LOCAL_NET signs in with an address alone: no link, no mail. An address
# is then the whole credential, so it is for a network you trust and nothing
# else. The server refuses to start with it when APP_URL is a public hostname,
# unless I_KNOW_SECURE_LOCAL_NET_IS_PUBLIC=true.
# SECURE_LOCAL_NET=true

# Or an OpenID Connect provider: see OIDC_ISSUER below, or pair one from the
# login page.

# ── Optional ──────────────────────────────────────────────────────────────────

# Public URL the app is served at. Sign-in links are built from it, so set it
# to the address users actually type — a link to localhost is useless in an
# inbox. Defaults to http://localhost:PORT.
# APP_URL=http://localhost:3001

# Where a browser reaches this server, for the OIDC sign-in's start and
# callback. Defaults to APP_URL in production, where they are the same, and to
# http://localhost:PORT in development, where the app is on a port of its own.
# SERVER_URL=http://localhost:3001

# How many reverse proxies sit in front of the server (1 behind nginx, Caddy or
# Traefik), or any Express `trust proxy` value. Sign-in is throttled per client
# address, which the server reads from X-Forwarded-For only when told to. Unset
# behind a proxy, every visitor shares one budget. Never "true" on a port the
# internet reaches directly. Default: false
# TRUST_PROXY=1

# Port the server listens on. Default: 3001
# PORT=3001

# Sign in through an OpenID Connect provider (heautou, or any other), next to
# magic links. A provider that supports Dynamic Client Registration is easier
# to pair from the app: paste its setup URL on a new instance's login page, or
# in Settings → Sign-in. These settings win over a pairing.
# Set both OIDC_ISSUER and OIDC_CLIENT_ID to turn it on; the login page then
# shows a "Sign in with OIDC_NAME" button. Register this redirect URI
# with the provider, exactly: SERVER_URL/api/auth/callback/oidc (the server
# prints it at boot)
# A user the provider vouches for is signed in to the account with the same
# email address, or gets a new one. For heautou the issuer ends in /oidc, and a
# client's allowedGroups decides who may sign in.
# OIDC_ISSUER=https://id.example.com/oidc
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# How the secret is sent: client_secret_basic (heautou's default) or
# client_secret_post. Leave OIDC_CLIENT_SECRET unset for a public client.
# OIDC_CLIENT_AUTH=client_secret_basic
# The provider's name on the button. Default: SSO
# OIDC_NAME=heautou
# Apps that cannot open a browser here (Home Assistant) sign in at the provider
# with the device flow and send its access token as a bearer. Telos accepts a
# token from the provider in effect (set here or paired) whose audience is this
# one, for someone who has signed in to Telos through the provider once.
# Default: SERVER_URL/graphql. Register it at the provider as an API resource.
# OIDC_API_AUDIENCE=https://telos.example.com/graphql
# The provider's public client for device apps; Telos only passes its name on
# (authConfig.sso.deviceClientId). Pairing with heautou registers one for you,
# which heautou's admin turns on when finishing the pairing; set this only to
# use another, or with OIDC_ISSUER.
# OIDC_DEVICE_CLIENT_ID=

# Set to false to remove AI from this server entirely: no MCP endpoint, no API
# keys, no agents, and the app shows none of it. Otherwise an admin (the first
# account to sign up) switches AI on for the instance in Settings; it starts
# off, and each account and project still has its own switch, also off.
# AI_ENABLED=false

# The runner is part of the server and signs itself in with a key made up at
# boot; none of the RUNNER_ settings below need setting.

# Seconds the runner waits between asks when nothing is ready. Default: 5
# RUNNER_POLL_SECONDS=5

# The most runs the runner works at once, across every user. Default: 2
# RUNNER_CONCURRENCY=2

# Let check lanes run their shell commands on the runner's host.
# Off by default: a check runs with the runner's rights. Turn it on only when
# every user with AI on is someone you would hand a shell.
# (RUNNER_ALLOW_STDIO is gone: telos does not run stdio MCP servers, only ones
# at a URL. The runner warns if it is still set.)
# RUNNER_ALLOW_CHECKS=false

# Only for a second runner on another host (`npm start -w @telos/runner`, with
# TELOS_URL pointing here): the key both sides share. openssl rand -hex 32
# RUNNER_KEY=

# Where the Expo dev client looks for the API. Only used by `npm run dev:app`;
# in production the server serves the built app from its own origin. Unset, the
# client calls PORT on whatever host the page was opened from, so the dev server
# works over the network without configuration.
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Port the dev client calls the API on, when EXPO_PUBLIC_API_URL is unset.
# Set this to match PORT if you change it. Default: 3001
# EXPO_PUBLIC_API_PORT=3001

# Address `npm run db:up` publishes the dev Postgres on. Defaults to 127.0.0.1,
# which is the loopback of whichever machine runs the Docker daemon — so if
# `docker context ls` shows a remote endpoint, set this to 0.0.0.0 and point
# DATABASE_URL at that host. Only ever do that on a network you trust.
# POSTGRES_BIND=127.0.0.1

# Host port the dev Postgres is published on. Default: 5435
# POSTGRES_PORT=5435
