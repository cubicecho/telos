# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Telos is Postgres-only and refuses to boot
# without this. `npm run db:up` starts a local one matching this default.
DATABASE_URL=postgres://telos:telos@127.0.0.1:5435/telos

# Secret sessions are signed with. The server refuses to start in production
# while this is unset or still the default. JWT_SECRET, its old name, is still
# read when this is unset.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# ── Optional ──────────────────────────────────────────────────────────────────

# Public URL the app is served at. Magic-link URLs are built from it, so set it
# to the address users actually type — a link to localhost is useless in an
# inbox. Defaults to http://localhost:PORT.
# APP_URL=http://localhost:3001

# Port the server listens on. Default: 3001
# PORT=3001

# Set to "false" to skip magic-link verification entirely: requesting a link
# signs you straight in and returns a session token. Intended for a private
# self-hosted instance with no mail relay. Never do this on the open internet.
# AUTH_MAGIC_LINK=true

# Return the magic link in the API response so it can be copied from the login
# page. Defaults to true outside production; set it explicitly to run a
# production instance that has no way to send mail.
# EXPOSE_MAGIC_LINK=false

# Set to false to remove AI from this server entirely: no MCP endpoint, no API
# keys, no agents, and the app shows none of it. Otherwise an admin (the first
# account to sign up) switches AI on for the instance in Settings; it starts
# off, and each account and project still has its own switch, also off.
# AI_ENABLED=false

# The key the runner (`runner/`) sends as x-runner-key to claim and finish
# runs. Unset, nothing can act as the runner, and the runner does not start.
# Generate one with: openssl rand -hex 32
# RUNNER_KEY=

# Where the runner finds telos. Default: http://127.0.0.1:PORT
# TELOS_URL=http://127.0.0.1:3001

# Seconds the runner waits between asks when nothing is ready. Default: 5
# RUNNER_POLL_SECONDS=5

# The most runs the runner works at once, across every user. Default: 2
# RUNNER_CONCURRENCY=2

# Let agents name MCP servers the runner spawns as commands on its own host.
# Off by default: a command runs with the runner's rights. Turn it on only when
# every user with AI on is someone you would hand a shell.
# RUNNER_ALLOW_STDIO=false

# Where the Expo dev client looks for the API. Only used by `npm run dev:app`;
# in production the server serves the built app from its own origin. Unset, the
# client calls PORT on whatever host the page was opened from, so the dev server
# works over the network without configuration.
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Port the dev client calls the API on, when EXPO_PUBLIC_API_URL is unset.
# Set this to match PORT if you change it. Default: 3001
# EXPO_PUBLIC_API_PORT=3001

# Address `npm run db:up` publishes the dev Postgres on. Defaults to 127.0.0.1,
# which is the loopback of whichever machine runs the Docker daemon — so if
# `docker context ls` shows a remote endpoint, set this to 0.0.0.0 and point
# DATABASE_URL at that host. Only ever do that on a network you trust.
# POSTGRES_BIND=127.0.0.1

# Host port the dev Postgres is published on. Default: 5435
# POSTGRES_PORT=5435
