{
  "name": "@telos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./relations": "./src/relations.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
