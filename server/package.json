{
  "name": "@telos/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --experimental-strip-types --env-file-if-exists=../.env --watch src/index.ts",
    "build": "echo 'no server build needed — TypeScript runs directly'",
    "start": "node --experimental-strip-types src/index.ts",
    "clean": "rm -rf __generated__",
    "codegen": "node --experimental-strip-types --import=./src/core/preload-env.ts src/graphql/write-schema.ts && graphql-codegen-esm"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.6",
    "@cubicecho/graphql-better-auth": "^1.1.0",
    "@cubicecho/graphql-mcp": "^3.0.0",
    "@telos/db": "*",
    "@telos/runner": "*",
    "@vantreeseba/drizzle-graphql": "^13.0.0",
    "better-auth": "^1.7.6",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "graphql": "^16.10.0",
    "graphql-parse-resolve-info": "^4.14.1",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.24.6",
    "nodemailer": "^8.0.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "graphql-sse": "^2.6.3"
  }
}
